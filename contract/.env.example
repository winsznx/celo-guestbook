# Smart Contract Environment Variables
# Copy this file to .env and fill in your actual values

# Deployer Private Key (Required for deployment)
# WARNING: Never commit this file with real values!
# Export from your wallet (e.g., MetaMask) - must have CELO for gas fees
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Block Explorer API Keys (Required for contract verification)
# Get BaseScan API key from: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# Get CeloScan API key from: https://celoscan.io/myapikey
CELOSCAN_API_KEY=your_celoscan_api_key_here

# Optional: Custom RPC URLs (defaults are in hardhat.config.js)
# CELO_RPC_URL=https://forno.celo.org
# ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
# BASE_RPC_URL=https://mainnet.base.org

# Optional: Etherscan API key for Base verification
# ETHERSCAN_API_KEY=your_etherscan_api_key_here
